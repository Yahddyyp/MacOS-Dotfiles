[
  {
    "context": "Workspace",
    "bindings": {
      "tab": "pane::ActivateNextItem",
      "shift-tab": "pane::ActivatePreviousItem",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-e": "workspace::NewFile",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "jj": "vim::NormalBefore",
      "space w": "workspace::Save",
      "space q": "pane::CloseActiveItem",
      "space f": "file_finder::Toggle",
      "space r n": "editor::Rename",
      "space e": "project_panel::Toggle",
      "space h": "zed::ShowWelcome",
      "space c": "buffer_search::Dismiss",
      "space p": "workspace::ToggleRightDock",
      "space b d": "pane::CloseActiveItem",
      "space x": "pane::CloseActiveItem",
      "ctrl-/": "terminal_panel::Toggle",
      "space t": "debug_panel::Toggle",
      "space g g": "git_panel::Toggle",
      "Tab": "pane::ActivateNextItem",
      "shift-Tab": "pane::ActivatePreviousItem",
      "escape": ["workspace::SendKeystrokes", ": n o h enter"],
      "n": ["workspace::SendKeystrokes", "n z z z"],
      "N": ["workspace::SendKeystrokes", "shift-n z z z"],
      "x": ["workspace::SendKeystrokes", "\" _ x"],
    },
  },
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "space space": "file_finder::Toggle",
      "U": "editor::Redo",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j j": "vim::NormalBefore",
      "j k": "vim::NormalBefore",
    },
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "<": ["workspace::SendKeystrokes", "< g v"],
      ">": ["workspace::SendKeystrokes", "> g v"],
    },
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "g 1": ["pane::ActivateItem", 0],
      "g 2": ["pane::ActivateItem", 1],
      "g 3": ["pane::ActivateItem", 2],
      "g 4": ["pane::ActivateItem", 3],
      "g 5": ["pane::ActivateItem", 4],
      "g 6": ["pane::ActivateItem", 5],
      "g 7": ["pane::ActivateItem", 6],
      "g 8": ["pane::ActivateItem", 7],
      "g 9": ["pane::ActivateItem", 8],
      "g 0": ["pane::ActivateItem", 9],
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "tab": ["terminal::SendText", "\t"],
      "shift-tab": ["terminal::SendText", "\u001b[Z"],
    },
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "space": null,
      "space /": "pane::DeploySearch",
      "space s g": "pane::DeploySearch",
      "space s b": "buffer_search::Deploy",
      "H": "vim::FirstNonWhitespace",
      "L": "vim::EndOfLine",
    },
  },
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "space c a": "editor::ToggleCodeActions",
      "space x x": "diagnostics::Deploy",
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
    },
  },
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "space o p": "markdown::OpenPreview",
      "space o P": "markdown::OpenPreviewToTheSide",
    },
  }
]
